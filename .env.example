# Run `npm run setup` to generate a private .env. Never commit that file.
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
HOST=0.0.0.0
PORT=3000
POSTGRES_USER=sitewatch
POSTGRES_DB=sitewatch
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
DATABASE_URL=postgresql://sitewatch:YOUR_DATABASE_PASSWORD@localhost:55432/sitewatch
ADMIN_USERNAME=admin
# scrypt hash; no default administrator password is included.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Optional SMTP. Leave blank to use dashboard notifications only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
